{
  "name": "@embedpdf/angular-pdf-viewer",
  "private": true,
  "version": "0.0.0",
  "description": "Angular component for embedding PDF documents",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "sideEffects": false,
  "homepage": "https://www.embedpdf.com/angular-pdf-viewer",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./angular": {
      "types": "./dist/angular/index.d.ts",
      "import": "./dist/angular/index.js",
      "require": "./dist/angular/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build:base": "vite build --mode base",
    "build:angular": "vite build --mode angular",
    "build": "pnpm run clean && vite build --mode base && vite build --mode angular"
  },
  "devDependencies": {
    "@angular/build": "^21.2.10",
    "@angular/compiler": "^21.2.12",
    "@angular/compiler-cli": "^21.2.12",
    "@angular/core": "^21.2.12",
    "@embedpdf/build": "workspace:*",
    "rimraf": "^6.1.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@angular/core": ">=21.0.0"
  },
  "keywords": [
    "angular",
    "pdf",
    "viewer",
    "embed",
    "document"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/embedpdf/embed-pdf-viewer.git",
    "directory": "viewers/angular"
  },
  "publishConfig": {
    "access": "public"
  }
}
