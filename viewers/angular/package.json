{
  "name": "@embedpdf/angular-pdf-viewer",
  "version": "0.0.0",
  "description": "Angular component for embedding PDF documents",
  "module": "./dist/fesm2022/embedpdf-angular-pdf-viewer.mjs",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://www.embedpdf.com/angular-pdf-viewer",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/fesm2022/embedpdf-angular-pdf-viewer.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf dist dist-vite",
    "build": "pnpm run clean && pnpm run check-types && ng-packagr -p ng-package.json -c tsconfig.lib.json && node ./scripts/prepare-dist-package.mjs",
    "build:vite": "rimraf dist-vite && pnpm run check-types && vite build",
    "check-types": "tsc --noEmit -p tsconfig.lib.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@embedpdf/snippet": "workspace:*",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.5.0",
    "@analogjs/vitest-angular": "^2.5.0",
    "@embedpdf/vitest-config": "workspace:*",
    "@angular/build": "^21.2.10",
    "@angular/compiler": "^21.2.12",
    "@angular/compiler-cli": "^21.2.12",
    "@angular/core": "^21.2.12",
    "@angular/platform-browser": "^21.2.12",
    "@vitest/browser": "^4.0.8",
    "@vitest/browser-playwright": "^4.0.8",
    "playwright": "^1.50.0",
    "jsdom": "^25.0.1",
    "ng-packagr": "^21.0.0",
    "rimraf": "^6.1.2",
    "rxjs": "^7.8.2",
    "typescript": "^5.1.6",
    "unplugin-dts": "1.0.0-beta.6",
    "vite": "^6.3.5",
    "vitest": "^4.0.8"
  },
  "peerDependencies": {
    "@angular/core": ">=21.0.0"
  },
  "keywords": [
    "angular",
    "pdf",
    "viewer",
    "embed",
    "document"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/embedpdf/embed-pdf-viewer.git",
    "directory": "viewers/angular"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist",
    "linkDirectory": false
  }
}
