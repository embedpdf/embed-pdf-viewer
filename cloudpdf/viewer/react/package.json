{
  "name": "@cloudpdf/viewer-react",
  "version": "3.2.0",
  "private": false,
  "description": "A complete PDF viewer as a React component, with CloudPDF as its engine: the file stays on the server, and pages arrive as images.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "epdf-build",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/embedpdf/embed-pdf-viewer.git",
    "directory": "cloudpdf/viewer/react"
  },
  "homepage": "https://www.cloudpdf.com",
  "bugs": {
    "url": "https://github.com/embedpdf/embed-pdf-viewer/issues"
  },
  "keywords": [
    "pdf",
    "cloudpdf",
    "viewer",
    "react",
    "cloud"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@cloudpdf/viewer": "workspace:*",
    "@embedpdf/viewer-react": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@embedpdf/tooling-build": "workspace:*",
    "@types/react": "^18.3.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "epdf": {
    "devExports": "development"
  }
}
