{
  "name": "@cloudpdf/viewer",
  "version": "3.0.0-next.17",
  "private": false,
  "description": "The open-source EmbedPDF viewer with the CloudPDF engine as its default: <embedpdf-viewer>, init() and every framework wrapper's names, pages rendered on CloudPDF SaaS or your own @cloudpdf/server, the local engine loaded only when stamps need it. dist/cloudpdf.js is the same door for a script tag.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./snippet": {
      "types": "./dist/index.d.ts",
      "default": "./dist/cloudpdf.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rimraf dist && vite build && vite build --mode snippet && tsc -p tsconfig.decl.json",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/embedpdf/embed-pdf-viewer.git",
    "directory": "cloudpdf/viewer/main"
  },
  "homepage": "https://www.cloudpdf.com",
  "bugs": {
    "url": "https://github.com/embedpdf/embed-pdf-viewer/issues"
  },
  "keywords": [
    "pdf",
    "cloudpdf",
    "viewer",
    "cloud"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@cloudpdf/engine": "workspace:*",
    "@embedpdf/engine": "workspace:*",
    "@embedpdf/viewer": "workspace:*"
  },
  "devDependencies": {
    "@embedpdf/engine-runtime-wasm32": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./src/index.ts",
    "./dist/*.js",
    "./dist/**/*.js"
  ]
}
