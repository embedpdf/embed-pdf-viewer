{
  "name": "@cloudpdf/viewer",
  "version": "3.0.0-next.0",
  "private": false,
  "description": "The full viewer wired to the CloudPDF engine: one CDN artifact (cloudpdf.js) exposing CloudPDF.init(). A thin EE wrapper over the Apache-2.0 @embedpdf/viewer — no wasm, no workers: rendering happens on a @cloudpdf/server deployment (or CloudPDF SaaS) over HTTPS.",
  "type": "module",
  "main": "./dist/cloudpdf.js",
  "module": "./dist/cloudpdf.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/cloudpdf.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.decl.json",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/embedpdf/embed-pdf-viewer",
    "directory": "cloudpdf/viewer/main"
  },
  "homepage": "https://www.cloudpdf.com",
  "bugs": {
    "url": "https://github.com/embedpdf/embed-pdf-viewer/issues"
  },
  "keywords": [
    "pdf",
    "cloudpdf",
    "viewer",
    "cloud"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@cloudpdf/engine": "workspace:*",
    "@embedpdf/viewer": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./dist/*.js",
    "./dist/**/*.js"
  ]
}
