{
  "name": "@cloudpdf/viewer-vue",
  "version": "3.0.0-next.14",
  "private": false,
  "description": "Vue wrapper for the full viewer wired to CloudPDF: a thin cloud door over @embedpdf/viewer-vue's engine-agnostic entry.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "epdf-build",
    "clean": "rimraf dist",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/embedpdf/embed-pdf-viewer.git",
    "directory": "cloudpdf/viewer/vue"
  },
  "homepage": "https://www.cloudpdf.com",
  "bugs": {
    "url": "https://github.com/embedpdf/embed-pdf-viewer/issues"
  },
  "keywords": [
    "pdf",
    "cloudpdf",
    "viewer",
    "vue",
    "cloud"
  ],
  "dependencies": {
    "@cloudpdf/viewer": "workspace:*",
    "@embedpdf/viewer-vue": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.4"
  },
  "devDependencies": {
    "@embedpdf/tooling-build": "workspace:*",
    "rimraf": "^5.0.0",
    "typescript": "~5.8.3",
    "vue": "^3.5.13",
    "vue-tsc": "^3.2.4"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "epdf": {
    "devExports": "development"
  }
}
