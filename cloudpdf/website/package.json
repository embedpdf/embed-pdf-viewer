{
  "name": "@cloudpdf/website",
  "private": true,
  "scripts": {
    "api:check": "node scripts/generate-api-reference.mjs --check && node scripts/check-api-reference.mjs && node --test scripts/*.test.mjs",
    "api:metadata": "node scripts/sync-api-reference-metadata.mjs",
    "api:pages": "node scripts/generate-api-reference.mjs",
    "api:snippets": "node scripts/extract-sdk-snippets.mjs",
    "build": "next build",
    "build:demos": "vite build --config vite.demos.config.ts && vite build --config vite.demos-ng.config.ts",
    "check:samples": "tsc -p tsconfig.samples-cloud.json",
    "clean": "rm -rf .next node_modules/.cache",
    "dev": "pnpm run build:demos && pnpm run search:index:build && next dev -p 3400",
    "dev:clean": "rm -rf .next && next dev",
    "docs:check": "node ../../docs/content/scripts/sync.mjs --target . --engine cloud --check",
    "docs:sync": "node ../../docs/content/scripts/sync.mjs --target . --engine cloud",
    "lint": "next lint",
    "og:preview": "node ../../docs/kit/scripts/collect-og-cards.mjs",
    "prebuild": "pnpm api:check && pnpm run docs:check && pnpm run search:index:build",
    "search:index": "tsx scripts/build-search-index.ts",
    "search:index:build": "tsx scripts/build-search-index.ts --if-configured",
    "start": "next start"
  },
  "dependencies": {
    "@cloudpdf/engine": "workspace:*",
    "@embedpdf/docs-kit": "workspace:*",
    "@embedpdf/engine": "workspace:*",
    "@embedpdf/react": "workspace:*",
    "@hugeicons/core-free-icons": "^4.2.0",
    "@hugeicons/react": "^1.1.7",
    "@theguild/remark-npm2yarn": "^0.3.3",
    "next": "^15.4.10",
    "nextra": "^4.6.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "shiki": "3.14.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@angular/common": "~20.2.0",
    "@angular/compiler": "~20.2.0",
    "@angular/core": "~20.2.0",
    "@angular/platform-browser": "~20.2.0",
    "@embedpdf/angular": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tailwindcss/postcss": "^4.0.6",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "eslint-config-next": "15.5.12",
    "postcss": "^8.4.32",
    "svelte": "^5.39.5",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "vite": "^6.3.5",
    "vue": "^3.5.13"
  }
}
