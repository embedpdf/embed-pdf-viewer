{
  "name": "@cloudpdf/server-modules",
  "version": "3.0.0-next.19",
  "private": false,
  "description": "Write CloudPDF server modules: packages that run inside @cloudpdf/server with their own routes and permissions, and reach documents through the engine's document API, as the caller and as themselves.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "epdf-build",
    "clean": "rimraf dist",
    "lint": "eslint src --color",
    "lint:fix": "eslint src --color --fix",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/embedpdf/embed-pdf-viewer.git",
    "directory": "cloudpdf/server-modules"
  },
  "homepage": "https://www.cloudpdf.com",
  "bugs": {
    "url": "https://github.com/embedpdf/embed-pdf-viewer/issues"
  },
  "keywords": [
    "pdf",
    "cloudpdf",
    "server",
    "modules",
    "plugins"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@cloudpdf/engine": "workspace:*",
    "@embedpdf/engine-core": "workspace:*"
  },
  "peerDependencies": {
    "@cloudpdf/server": "workspace:*"
  },
  "devDependencies": {
    "@cloudpdf/server": "workspace:*",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.0",
    "@embedpdf/tooling-build": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "sideEffects": false,
  "epdf": {
    "devExports": "development"
  }
}
