{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "outDir": "./out-tsc"
  },
  "files": ["src/main.ts"],
  "angularCompilerOptions": {
    "strictTemplates": true
  }
}
