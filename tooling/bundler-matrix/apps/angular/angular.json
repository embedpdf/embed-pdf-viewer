{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "cache": {
      "enabled": true,
      "environment": "all"
    }
  },
  "projects": {
    "matrix": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist",
              "browser": ""
            },
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [],
            "tsConfig": "tsconfig.json"
          },
          "configurations": {
            "production": {
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "assets": {
              "outputHashing": "all",
              "assets": [
                {
                  "glob": "embedpdf.wasm",
                  "input": "node_modules/@embedpdf/engine-runtime-wasm32/lib",
                  "output": "/embedpdf"
                }
              ],
              "index": {
                "input": "src/index.assets.html",
                "output": "index.html"
              }
            },
            "portable": {
              "outputHashing": "all",
              "browser": "src/main.portable.ts"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": {
              "buildTarget": "matrix:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
