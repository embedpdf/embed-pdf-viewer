{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "4",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@embedpdf/engine#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/engine/runtime/npm/wasm32/lib/embedpdf.browser.js"],
      "outputs": ["dist/**", "workers/**", "src/generated/**"]
    },
    "@embedpdf/engine-runtime#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "npm/wasm32/lib/embedpdf.wasm"],
      "outputs": ["dist/**", "npm/wasm32/lib/wasm-inline.js"]
    },
    "@embedpdf/website#build:demos": {
      "dependsOn": ["^build"],
      "outputs": ["public/demos/**"]
    },
    "@embedpdf/website#build": {
      "dependsOn": ["build:demos", "^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "@cloudpdf/website#build:demos": {
      "dependsOn": ["^build"],
      "outputs": ["public/demos/**"]
    },
    "@cloudpdf/website#build": {
      "dependsOn": ["build:demos", "^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "@embedpdf/default-stamps#build": {
      "outputs": ["locales/**"]
    },
    "@embedpdf/viewer#test": {
      "dependsOn": ["build"]
    }
  }
}
