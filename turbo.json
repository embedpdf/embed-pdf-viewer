{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "4",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "outputs": [],
      "inputs": [
        "src/**",
        "test/**",
        "vite.config.ts",
        "vitest.config.ts",
        "vitest.browser.config.ts",
        "tsconfig.json",
        "package.json"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
