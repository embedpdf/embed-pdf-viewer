{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "4",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@embedpdf/website#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "public/demos/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "typecheck": {},
    "test": {},
    "dev": {
      "persistent": true,
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
