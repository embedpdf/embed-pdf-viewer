{
  "name": "@embedpdf/viewer-chrome",
  "version": "3.0.0-next.6",
  "private": false,
  "description": "The full viewer's chrome - the one React implementation of the snippet UI (structure-only chrome schema, measured toolbar, Tailwind pixels). Published as an implementation dependency of @embedpdf/viewer; it is not a documented user-facing entry point for now.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./chrome": {
      "development": "./src/config/chrome.ts",
      "import": "./dist/chrome.js",
      "require": "./dist/chrome.cjs"
    },
    "./commands": {
      "development": "./src/config/commands.ts",
      "import": "./dist/commands.js",
      "require": "./dist/commands.cjs"
    },
    "./package.json": "./package.json",
    "./styles.css": "./src/styles.css"
  },
  "epdf": {
    "rawExports": [
      "./styles.css"
    ],
    "devExports": "development"
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "scripts": {
    "build": "epdf-build",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@embedpdf/react": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.0.0",
    "@embedpdf/tooling-build": "workspace:*",
    "tailwindcss": "^4.1.18"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./chrome": {
        "import": "./dist/chrome.js",
        "require": "./dist/chrome.cjs"
      },
      "./commands": {
        "import": "./dist/commands.js",
        "require": "./dist/commands.cjs"
      },
      "./package.json": "./package.json",
      "./styles.css": "./src/styles.css"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/embedpdf/embed-pdf-viewer.git",
    "directory": "packages/viewer/chrome"
  }
}
