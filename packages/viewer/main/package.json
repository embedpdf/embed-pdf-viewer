{
  "name": "@embedpdf/viewer",
  "version": "0.0.0",
  "private": true,
  "description": "The full viewer, delivered: the <embedpdf-viewer> custom element + EmbedPDF.init(). One Preact-compiled artifact of @embedpdf/viewer-chrome with the local wasm engine wired in — the thing the CDN serves and every framework wrapper wraps. Ships DIST only (the preact aliasing happens in THIS package's build), so consumers never compile the chrome.",
  "type": "module",
  "main": "./dist/embedpdf.js",
  "module": "./dist/embedpdf.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/embedpdf.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.decl.json",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@embedpdf/engine": "workspace:*",
    "@embedpdf/viewer-chrome": "workspace:*",
    "preact": "^10.25.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "license": "Apache-2.0",
  "sideEffects": [
    "./src/element.ts",
    "./dist/*.js"
  ]
}
