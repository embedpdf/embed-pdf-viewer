{
  "name": "@embedpdf/viewer",
  "version": "3.2.0",
  "private": false,
  "description": "A complete PDF viewer for any web page: one element with toolbars, annotations, forms and signatures, with the PDF engine built in.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/doors/local.d.ts",
  "exports": {
    ".": {
      "types": "./dist/doors/local.d.ts",
      "default": "./dist/index.js"
    },
    "./portable": {
      "types": "./dist/doors/portable.d.ts",
      "default": "./dist/portable.js"
    },
    "./core": {
      "types": "./dist/doors/core.d.ts",
      "default": "./dist/core.js"
    },
    "./snippet": {
      "types": "./dist/doors/snippet.d.ts",
      "default": "./dist/embedpdf.js"
    },
    "./strings/en.json": "./dist/strings/en.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "rimraf dist && vite build && vite build --mode snippet && tsc -p tsconfig.decl.json",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@embedpdf/core": "workspace:*",
    "@embedpdf/core-annotation": "workspace:*",
    "@embedpdf/core-fonts": "workspace:*",
    "@embedpdf/core-ui": "workspace:*",
    "@embedpdf/default-signature-fonts": "workspace:*",
    "@embedpdf/default-stamps": "workspace:*",
    "@embedpdf/engine": "workspace:*",
    "@embedpdf/engine-core": "workspace:*",
    "@embedpdf/plugin-actions": "workspace:*",
    "@embedpdf/plugin-annotation": "workspace:*",
    "@embedpdf/plugin-attachment": "workspace:*",
    "@embedpdf/plugin-commands": "workspace:*",
    "@embedpdf/plugin-fonts": "workspace:*",
    "@embedpdf/plugin-form": "workspace:*",
    "@embedpdf/plugin-history": "workspace:*",
    "@embedpdf/plugin-i18n": "workspace:*",
    "@embedpdf/plugin-interaction": "workspace:*",
    "@embedpdf/plugin-link": "workspace:*",
    "@embedpdf/plugin-measurement": "workspace:*",
    "@embedpdf/plugin-metadata": "workspace:*",
    "@embedpdf/plugin-outline": "workspace:*",
    "@embedpdf/plugin-page-edit": "workspace:*",
    "@embedpdf/plugin-redaction": "workspace:*",
    "@embedpdf/plugin-render": "workspace:*",
    "@embedpdf/plugin-search": "workspace:*",
    "@embedpdf/plugin-selection": "workspace:*",
    "@embedpdf/plugin-shell": "workspace:*",
    "@embedpdf/plugin-signature": "workspace:*",
    "@embedpdf/plugin-stage": "workspace:*",
    "@embedpdf/plugin-stamp": "workspace:*",
    "@embedpdf/viewer-chrome": "workspace:*",
    "@embedpdf/web": "workspace:*",
    "preact": "^10.25.0"
  },
  "devDependencies": {
    "@embedpdf/engine-runtime-wasm32": "workspace:*",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./src/kernel/element.ts",
    "./src/kernel/components.ts",
    "./src/doors/*.ts",
    "./dist/*.js",
    "./dist/**/*.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/embedpdf/embed-pdf-viewer.git",
    "directory": "packages/viewer/main"
  }
}
