{
  "name": "@embedpdf/plugin-stage",
  "version": "3.0.0-next.11",
  "private": false,
  "description": "The Stage plugin: one coordinate core (scroll + viewport + zoom + pan + spread) built on @embedpdf/core-stage. Pure intents & selectors; no DOM.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts",
    "./destination": "./src/destination.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./contract": {
        "import": "./dist/contract.js",
        "require": "./dist/contract.cjs"
      },
      "./destination": {
        "import": "./dist/destination.js",
        "require": "./dist/destination.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "epdf-build",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@embedpdf/core-geometry": "workspace:*",
    "@embedpdf/core": "workspace:*",
    "@embedpdf/plugin-interaction": "workspace:*",
    "@embedpdf/core-stage": "workspace:*",
    "@embedpdf/plugin-actions": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^2.1.9",
    "@embedpdf/tooling-build": "workspace:*",
    "@embedpdf/engine": "workspace:*"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/embedpdf/embed-pdf-viewer.git",
    "directory": "packages/plugin/stage"
  }
}
