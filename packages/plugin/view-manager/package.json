{
  "name": "@embedpdf/plugin-view-manager",
  "version": "3.1.0",
  "private": false,
  "description": "Several documents for EmbedPDF: shows open documents side by side.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./contract": {
        "import": "./dist/contract.js",
        "require": "./dist/contract.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "epdf-build",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@embedpdf/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@embedpdf/tooling-build": "workspace:*",
    "vitest": "^2.1.9"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/embedpdf/embed-pdf-viewer.git",
    "directory": "packages/plugin/view-manager"
  }
}
