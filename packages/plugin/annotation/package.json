{
  "name": "@embedpdf/plugin-annotation",
  "version": "3.0.0-next.0",
  "private": false,
  "description": "Annotation feature plugin: the pure annotation-core wired to the engine repository (optimistic create/patch/delete) + the interaction hub (ambient edit + draw tools). Behaviors (forms) plug in here.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": "./src/index.ts",
    "./internal": "./src/internal.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./internal": {
        "import": "./dist/internal.js",
        "require": "./dist/internal.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "epdf-build",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@embedpdf/core": "workspace:*",
    "@embedpdf/core-annotation": "workspace:*",
    "@embedpdf/core-geometry": "workspace:*",
    "@embedpdf/plugin-interaction": "workspace:*",
    "@embedpdf/plugin-selection": "workspace:*",
    "@embedpdf/engine-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^2.1.9",
    "@embedpdf/tooling-build": "workspace:*"
  },
  "license": "Apache-2.0",
  "sideEffects": false
}
