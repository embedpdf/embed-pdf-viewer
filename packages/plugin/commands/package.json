{
  "name": "@embedpdf/plugin-commands",
  "version": "3.1.0",
  "private": false,
  "description": "Commands for EmbedPDF: named actions with a label, an icon, a state and a shortcut, for toolbars, menus and the keyboard.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts",
    "./contract/host": "./src/host-contract.ts",
    "./standard": "./src/standard.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./contract": {
        "import": "./dist/contract.js",
        "require": "./dist/contract.cjs"
      },
      "./contract/host": {
        "import": "./dist/contract/host.js",
        "require": "./dist/contract/host.cjs"
      },
      "./standard": {
        "import": "./dist/standard.js",
        "require": "./dist/standard.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "epdf-build",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@embedpdf/core": "workspace:*",
    "@embedpdf/core-ui": "workspace:*",
    "@embedpdf/plugin-annotation": "workspace:*",
    "@embedpdf/plugin-i18n": "workspace:*",
    "@embedpdf/plugin-interaction": "workspace:*",
    "@embedpdf/plugin-render": "workspace:*",
    "@embedpdf/plugin-selection": "workspace:*",
    "@embedpdf/plugin-shell": "workspace:*",
    "@embedpdf/plugin-stage": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^2.1.9",
    "@embedpdf/tooling-build": "workspace:*"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/embedpdf/embed-pdf-viewer.git",
    "directory": "packages/plugin/commands"
  }
}
