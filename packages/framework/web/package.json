{
  "name": "@embedpdf/web",
  "version": "3.1.0",
  "private": false,
  "description": "Framework-free browser adapters for EmbedPDF v3 — the one home for code that touches window/document (file dialog, clipboard, print…). Imported by the framework layers; never by a plugin or a *-core package, which stay DOM-free.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": "./src/index.ts",
    "./controller": "./src/controller.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./controller": {
        "import": "./dist/controller.js",
        "require": "./dist/controller.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "epdf-build",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@embedpdf/core": "workspace:*",
    "@embedpdf/core-geometry": "workspace:*",
    "@embedpdf/plugin-annotation": "workspace:*",
    "@embedpdf/plugin-form": "workspace:*",
    "@embedpdf/plugin-history": "workspace:*",
    "@embedpdf/plugin-interaction": "workspace:*",
    "@embedpdf/plugin-link": "workspace:*",
    "@embedpdf/plugin-outline": "workspace:*",
    "@embedpdf/plugin-render": "workspace:*",
    "@embedpdf/plugin-search": "workspace:*",
    "@embedpdf/plugin-selection": "workspace:*",
    "@embedpdf/plugin-stage": "workspace:*"
  },
  "devDependencies": {
    "happy-dom": "^20.11.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9",
    "@embedpdf/tooling-build": "workspace:*",
    "@embedpdf/engine": "workspace:*"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/embedpdf/embed-pdf-viewer.git",
    "directory": "packages/framework/web"
  }
}
