    ".": "./src/index.ts",
    "./actions": "./src/actions.ts",
    "./anchored": "./src/anchored.ts",
    "./annotation": "./src/annotation.ts",
    "./commands": "./src/commands.ts",
    "./form": "./src/form.ts",
