{
  "name": "@embedpdf/core-form",
  "version": "3.0.0-next.19",
  "private": false,
  "description": "The form widget painter: what a widget looks like for its facts, ported from the engine's appearance generator and checked against it. Pure TypeScript, DOM-free.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "epdf-build",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@embedpdf/core-annotation": "workspace:*",
    "@embedpdf/core-fonts": "workspace:*",
    "@embedpdf/core-text": "workspace:*",
    "@embedpdf/engine-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^2.1.9",
    "@embedpdf/tooling-build": "workspace:*"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/embedpdf/embed-pdf-viewer.git",
    "directory": "packages/core/form"
  }
}
