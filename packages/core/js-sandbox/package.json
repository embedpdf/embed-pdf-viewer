{
  "name": "@embedpdf/core-js-sandbox",
  "version": "3.0.0-next.4",
  "private": false,
  "description": "QuickJS-backed, resource-bounded execution adapter for deterministic Acrobat JavaScript.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "imports": {
    "#quickjs-variant": {
      "types": "@jitl/quickjs-wasmfile-release-sync",
      "browser": "@jitl/quickjs-singlefile-browser-release-sync",
      "default": "@jitl/quickjs-wasmfile-release-sync"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "epdf-build",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --dir ../acrojs build && vitest run"
  },
  "dependencies": {
    "@embedpdf/core-acrojs": "workspace:*",
    "@jitl/quickjs-singlefile-browser-release-sync": "0.32.0",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "quickjs-emscripten-core": "0.32.0"
  },
  "devDependencies": {
    "@embedpdf/engine": "workspace:*",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9",
    "@embedpdf/tooling-build": "workspace:*"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "inlinedDependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/embedpdf/embed-pdf-viewer.git",
    "directory": "packages/core/js-sandbox"
  }
}
