{
  "name": "@embedpdf/core-signature",
  "version": "3.2.0",
  "private": false,
  "description": "Digital signatures for EmbedPDF: signs a PDF and validates the signatures it has. No DOM.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "epdf-build",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@embedpdf/engine-core": "workspace:*",
    "asn1js": "^3.0.5",
    "pkijs": "^3.2.4"
  },
  "devDependencies": {
    "@embedpdf/engine": "workspace:*",
    "@embedpdf/tooling-build": "workspace:*",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/embedpdf/embed-pdf-viewer.git",
    "directory": "packages/core/signature"
  }
}
