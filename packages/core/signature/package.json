{
  "name": "@embedpdf/core-signature",
  "version": "3.4.0",
  "private": false,
  "description": "Digital signatures for EmbedPDF: signs a PDF and validates the signatures it has. No DOM.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./server": {
        "import": "./dist/server.js",
        "require": "./dist/server.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "epdf-build",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@embedpdf/engine-core": "workspace:*",
    "asn1js": "^4.0.0",
    "pkijs": "^4.0.1"
  },
  "devDependencies": {
    "@embedpdf/engine": "workspace:*",
    "@embedpdf/tooling-build": "workspace:*",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "epdf": {
    "bundleInCjs": [
      "pkijs",
      "asn1js",
      "bytestreamjs",
      "@peculiar/utils",
      "@noble/hashes"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/embedpdf/embed-pdf-viewer.git",
    "directory": "packages/core/signature"
  },
  "inlinedDependencies": {
    "@noble/hashes": "2.4.0",
    "@peculiar/utils": "4.1.0",
    "asn1js": "4.0.0",
    "bytestreamjs": "3.0.0",
    "pkijs": "4.0.1"
  }
}
