{
  "name": "@embedpdf/engine",
  "version": "0.0.0",
  "private": false,
  "description": "Engine v3 local implementation: WASM PDFium running inside a Web Worker (or inline for Node), driven by an O(log n) abort-aware WorkerQueue. Speaks the same Engine interface as the cloud engine.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./default-worker": {
      "development": "./src/default-worker.ts",
      "import": "./dist/default-worker.js",
      "require": "./dist/default-worker.cjs"
    },
    "./package.json": "./package.json",
    "./worker-entry": "./src/worker/worker-entry.ts"
  },
  "scripts": {
    "build": "epdf-build",
    "clean": "rimraf dist",
    "lint": "eslint src --color",
    "lint:fix": "eslint src --color --fix",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "dist",
    "src/worker/worker-entry.ts",
    "src/worker/bootstrap.ts",
    "src/worker/protocol.ts",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/embedpdf/embed-pdf-viewer",
    "directory": "packages/engine"
  },
  "homepage": "https://www.embedpdf.com",
  "bugs": {
    "url": "https://github.com/embedpdf/embed-pdf-viewer/issues"
  },
  "keywords": [
    "pdf",
    "embedpdf",
    "engine",
    "wasm"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@embedpdf/engine-core": "workspace:*",
    "@embedpdf/engine-services": "workspace:*",
    "@embedpdf/engine-runtime": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.0",
    "@embedpdf/tooling-build": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./default-worker": {
        "import": "./dist/default-worker.js",
        "require": "./dist/default-worker.cjs"
      },
      "./package.json": "./package.json",
      "./worker-entry": "./src/worker/worker-entry.ts"
    }
  },
  "epdf": {
    "rawExports": [
      "./worker-entry"
    ],
    "devExports": "development"
  },
  "sideEffects": false
}
