%PDF-1.7
% ò¤ô
% A page whose only font is a producer's subset of Helvetica: a Type0
% CIDFontType2 over a renumbered TrueType program carrying glyf, loca,
% hmtx, head, hhea and maxp and nothing else (no cmap, no OS/2, no name),
% as Quartz and other producers emit for Identity-H. The program is a
% three-glyph cut (.notdef, a, b) of the Roboto test font
% (third_party/harfbuzz-ng/src/perf/fonts/Roboto-Regular.ttf) made with
% fontTools, tables dropped after subsetting. Such a program renders what it
% was made for and can author nothing: rich text asking for Helvetica must
% resolve past it to the standard face.
1 0 obj <<
  /Type /Catalog
  /Pages 2 0 R
>>
endobj
2 0 obj <<
  /Type /Pages
  /Count 1
  /Kids [3 0 R]
>>
endobj
3 0 obj <<
  /Type /Page
  /Parent 2 0 R
  /Contents 4 0 R
  /MediaBox [0 0 300 300]
  /Resources <<
    /ProcSet [/PDF /Text]
    /Font <<
      /F1 5 0 R
    >>
  >>
>>
endobj
4 0 obj <<
  /Length 39
>>
stream
BT
/F1 24 Tf
20 260 Td
<00010002> Tj
ET
endstream
endobj
5 0 obj <<
  /Type /Font
  /Subtype /Type0
  /BaseFont /ABCDEF+Helvetica
  /Encoding /Identity-H
  /DescendantFonts [6 0 R]
>>
endobj
