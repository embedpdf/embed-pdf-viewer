  "publishConfig": {
    "access": "public"
  },
  "name": "@embedpdf/engine-runtime-wasm32",
  "type": "module",
  "main": "./lib/pdfium.node.cjs",
  "module": "./lib/pdfium.browser.js",
  "exports": {
    ".": {
      "node": {
        "import": "./lib/pdfium.node.js",
        "require": "./lib/pdfium.node.cjs"
      },
      "default": "./lib/pdfium.browser.js"
    },
    "./pdfium.wasm": "./lib/pdfium.wasm",
    "./wasm-url": {
      "types": "./wasm-url.d.ts",
      "default": "./wasm-url.js"
    }
  },
  "files": [
    "lib",
    "wasm-url.js",
    "wasm-url.d.ts",
    "README.md",
    "LICENSE"
  ]
}
