      "types": "./wasm-url.d.ts",
      "default": "./wasm-url.js"
    }
  },
  "files": [
    "lib",
    "wasm-url.js",
    "wasm-url.d.ts",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/embedpdf/embed-pdf-viewer.git",
    "directory": "packages/engine/runtime/npm/wasm32"
  }
}
