{
  "name": "embedpdf",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.4.0",
  "license": "MIT",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "build:website": "pnpm --filter @embedpdf/website run db:migrate:build && turbo run build --filter=@embedpdf/website...",
    "build:fresh": "pnpm clean && turbo run build",
    "clean": "turbo run clean && rimraf .turbo/cache",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,jsx,json,css,md}\"",
    "build:enterprise": "pnpm --filter @cloudpdf/admin-api build && pnpm --filter @cloudpdf/admin build && pnpm --filter @cloudpdf/engine build && pnpm --filter @cloudpdf/server build",
    "build:release": "turbo run build --filter=\"./packages/**\" && pnpm run build:enterprise",
    "verify:consume": "pnpm --filter @embedpdf/tooling-consume-fixtures run verify",
    "verify:engine-runtime-packages": "pnpm --filter @embedpdf/engine-runtime run verify:packages",
    "changeset": "changeset",
    "ci:publish": "pnpm publish -r --access public --report-summary $GITHUB_WORKSPACE/pnpm-publish-summary.json",
    "ci:publish:next": "pnpm publish -r --access public --tag next --publish-branch next --report-summary $GITHUB_WORKSPACE/pnpm-publish-summary.json"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.6",
    "@changesets/get-github-info": "^0.6.0",
    "@next/eslint-plugin-next": "^15.5.12",
    "@roarr/cli": "^5.12.4",
    "@types/node": "latest",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "concurrently": "^9.2.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.4.0",
    "glob": "^13.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "rimraf": "latest",
    "turbo": "latest",
    "turbowatch": "^2.29.4",
    "typescript": "^5.9.3",
    "vite": "^6.3.5"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,json,css,md,vue,svelte}": "prettier --write"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "^22.0.0"
    },
    "patchedDependencies": {
      "@changesets/assemble-release-plan@6.0.9": "patches/@changesets__assemble-release-plan@6.0.9.patch"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
