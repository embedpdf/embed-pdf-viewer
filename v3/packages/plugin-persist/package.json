{
  "name": "@embedpdf-x/plugin-persist",
  "version": "0.0.0",
  "private": true,
  "description": "Effects-only plugin: persists & restores Stage view-state. Demonstrates `requires` + `effects`. (Real builds would inject a storage port instead of localStorage.)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "epdf-build",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@embedpdf-x/kernel": "workspace:*",
    "@embedpdf-x/plugin-stage": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@embedpdf/tooling-build": "workspace:*"
  },
  "license": "MIT",
  "sideEffects": false
}
