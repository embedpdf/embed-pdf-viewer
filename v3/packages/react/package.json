    "@embedpdf-x/plugin-i18n": "workspace:*",
    "@embedpdf-x/plugin-interaction": "workspace:*",
    "@embedpdf-x/plugin-link": "workspace:*",
    "@embedpdf-x/plugin-metadata": "workspace:*",
    "@embedpdf-x/plugin-page-edit": "workspace:*",
    "@embedpdf-x/plugin-redaction": "workspace:*",
    "@embedpdf-x/plugin-render": "workspace:*",
    "@embedpdf-x/plugin-search": "workspace:*",
    "@embedpdf-x/plugin-selection": "workspace:*",
    "@embedpdf-x/plugin-shell": "workspace:*",
    "@embedpdf-x/plugin-stage": "workspace:*",
    "@embedpdf-x/plugin-stamp": "workspace:*",
    "@embedpdf-x/plugin-view-manager": "workspace:*",
    "@embedpdf-x/stage-core": "workspace:*",
    "@embedpdf-x/ui-core": "workspace:*",
    "@embedpdf-x/web": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "happy-dom": "^20.11.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9",
    "@embedpdf/tooling-build": "workspace:*"
  },
  "license": "MIT",
  "inlinedDependencies": {
    "zod": "3.25.76"
