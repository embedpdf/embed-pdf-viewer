{
  "name": "@embedpdf-x/js-sandbox",
  "version": "0.0.0",
  "private": true,
  "description": "QuickJS-backed, resource-bounded execution adapter for deterministic Acrobat JavaScript.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "imports": {
    "#quickjs-variant": {
      "types": "@jitl/quickjs-wasmfile-release-sync",
      "browser": "@jitl/quickjs-singlefile-browser-release-sync",
      "default": "@jitl/quickjs-wasmfile-release-sync"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --dir ../acrojs-core build && vitest run"
  },
  "dependencies": {
    "@embedpdf-x/acrojs-core": "workspace:*",
    "@jitl/quickjs-singlefile-browser-release-sync": "0.32.0",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "quickjs-emscripten-core": "0.32.0"
  },
  "devDependencies": {
    "@embedpdf/engine": "workspace:*",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9"
  },
  "license": "MIT"
}
