# Use separate Neon branches or projects for Development, Preview, and Production.
# Also backs the docs search index (`pnpm run search:index`).
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Generate a different random value for each environment. Never expose this to the browser.
FEEDBACK_HASH_SALT=replace-with-a-long-random-secret

# Docs search embeddings: used at build time to embed sections, and at request
# time to embed the query. Optional — without it search still works and ranks
# lexically; only semantic ranking ("how do I highlight text") is off.
# To route through Vercel AI Gateway instead, set OPENAI_EMBEDDINGS_URL to the
# gateway endpoint and put its key here. Never expose this to the browser.
OPENAI_API_KEY=sk-...
