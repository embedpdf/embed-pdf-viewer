{
  "name": "@embedpdf/website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run build:demos && next dev --port 3100",
    "build": "next build",
    "start": "next start",
    "db:migrate": "node scripts/migrate-feedback.mjs",
    "db:migrate:build": "node scripts/migrate-feedback.mjs --if-configured",
    "search:index": "tsx scripts/build-search-index.ts",
    "search:index:build": "tsx scripts/build-search-index.ts --if-configured",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && pnpm run check:samples",
    "check:samples": "tsc -p tsconfig.samples-engine.json && tsc -p tsconfig.samples-react.json && ngc -p tsconfig.samples-angular.json",
    "build:demos": "vite build --config vite.demos.config.ts && vite build --config vite.demos-ng.config.ts"
  },
  "dependencies": {
    "@embedpdf/angular": "workspace:*",
    "@embedpdf/engine": "workspace:*",
    "@embedpdf/react": "workspace:*",
    "@embedpdf/viewer-react": "workspace:*",
    "@hugeicons/core-free-icons": "^4.2.0",
    "@hugeicons/react": "^1.1.7",
    "@neondatabase/serverless": "^1.1.0",
    "@theguild/remark-npm2yarn": "^0.3.3",
    "github-slugger": "^2.0.0",
    "next": "^15.4.10",
    "nextra": "^4.6.1",
    "npm-to-yarn": "^3.0.1",
    "react": "^19.2.8",
    "react-dom": "^18.2.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "shiki": "3.14.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@angular/common": "~20.2.0",
    "@angular/compiler": "~20.2.0",
    "@angular/compiler-cli": "~20.2.0",
    "@angular/core": "~20.2.0",
    "@angular/platform-browser": "~20.2.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "postcss": "^8.5.6",
    "svelte": "^5.39.5",
    "tailwindcss": "^4.1.18",
    "tslib": "^2.6.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.10",
    "vue": "^3.5.13",
    "yaml": "^2.9.0"
  }
}
