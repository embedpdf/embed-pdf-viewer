{
  "name": "@embedpdf/example-angular-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./viewer/*": "./dist/examples/viewer/*.js"
  },
  "typesVersions": {
    "*": {
      "viewer/*": [
        "./dist/examples/viewer/*.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4301",
    "build": "pnpm build:app && pnpm build:examples",
    "build:app": "vite build",
    "build:examples": "vite --config vite.lib.config.ts build",
    "preview": "vite preview --host 127.0.0.1 --port 4301",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@angular/common": "^22.0.2",
    "@angular/compiler": "^22.0.2",
    "@angular/core": "^22.0.2",
    "@angular/platform-browser": "^22.0.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@embedpdf/angular-pdf-viewer": "*"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.1",
    "@angular/build": "^22.0.3",
    "@angular/compiler-cli": "^22.0.2",
    "@embedpdf/angular-pdf-viewer": "workspace:*",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.1.18",
    "glob": "^13.0.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^6.0.3",
    "vite": "^6.4.1",
    "vite-plugin-dts": "^4.5.4"
  }
}
